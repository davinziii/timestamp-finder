# Timestamp Finder needs no API keys or secrets.
# Transcripts are fetched server-side from YouTube's public caption endpoints.

# --- Local clip downloads (only when the app runs on your own computer) ---
# On automatically with `npm run dev`. Set to "true" to allow with `npm start`,
# or "false" to turn it off. Never enabled on Vercel.
# ENABLE_LOCAL_DOWNLOADS=true
# Where clips are saved. Default: ~/Videos/clips
# CLIPS_DIR=~/Videos/clips
# Path to yt-dlp if it isn't on your PATH (ffmpeg must be next to it or on PATH).
# YTDLP_PATH=C:\tools\yt-dlp.exe
# Path to ffmpeg if it isn't on your PATH (also used to detect NVIDIA GPU encoding).
# FFMPEG_PATH=C:\tools\ffmpeg.exe

# If you later add a paid transcript provider, a proxy, or semantic search,
# put the keys here (server-side only; never prefix them with NEXT_PUBLIC_).
